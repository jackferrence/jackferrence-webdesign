---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<BaseLayout title="Contact" description="Tell Jack Ferrence about your Southern California service business and get a straightforward website recommendation. Call or use the short project form.">
  <PageHero eyebrow="Start a project" title="Tell Jack what you do and what is not working." intro="You do not need a finished brief. A few honest details are enough to start the conversation." />

  <section class="section-pad bg-mist">
    <div class="container grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <aside>
        <p class="eyebrow">Talk directly</p>
        <h2 class="mt-6 text-balance text-4xl font-black tracking-[-0.05em] text-navy">Prefer the phone?</h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-slate">Call Jack. If he is on another call or at a jobsite, leave the business name and he will get back to you.</p>
        <a class="mt-7 inline-flex items-center gap-4 rounded-xl bg-navy px-5 py-4 text-white shadow-lg" href={site.phoneHref}>
          <span class="grid h-11 w-11 place-items-center rounded-full bg-accent" aria-hidden="true">
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M7.2 2.8 4.6 4.2c-.8.4-1.2 1.3-1 2.2 1.1 6.8 6.4 12.1 13.2 13.2.9.2 1.8-.2 2.2-1l1.4-2.6c.4-.8.2-1.8-.6-2.3l-2.9-1.9c-.7-.4-1.6-.3-2.1.3l-1.6 1.7a13 13 0 0 1-3-3l1.7-1.6c.6-.5.7-1.4.3-2.1l-1.9-2.9c-.5-.8-1.5-1-2.3-.6Z" /></svg>
          </span>
          <span><small class="block text-[10px] font-black uppercase tracking-[0.14em] text-white/55">Tap to call</small><b class="mt-1 block text-lg">{site.phoneDisplay}</b></span>
        </a>
        <p class="mt-4 text-sm text-slate">Or email <a class="font-extrabold text-navy underline decoration-accent decoration-2 underline-offset-4" href={site.emailHref}>{site.email}</a></p>

        <div class="mt-10 border-t border-line pt-7">
          <p class="text-xs font-black uppercase tracking-[0.15em] text-sea">Best fit</p>
          <p class="mt-4 text-sm leading-relaxed text-slate">Owner-operated service companies in Orange County and coastal SoCal—especially marine trades in Newport Harbor.</p>
        </div>
        <div class="mt-7 border-t border-line pt-7">
          <p class="text-xs font-black uppercase tracking-[0.15em] text-sea">What happens next</p>
          <p class="mt-4 text-sm leading-relaxed text-slate">Jack reviews the details, follows up directly, and schedules a 20-minute call if the project looks like a fit.</p>
        </div>
      </aside>

      <div class="rounded-2xl border border-line bg-paper p-6 shadow-[0_24px_70px_rgba(11,29,42,0.08)] sm:p-9 lg:p-12">
        <div class="flex items-center justify-between gap-4 border-b border-line pb-7">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.15em] text-accent">Project details</p>
            <h2 class="mt-2 text-2xl font-black tracking-[-0.035em] text-navy">A short form. No sales funnel.</h2>
          </div>
          <span class="hidden text-xs font-bold text-slate sm:block">Usually 2 minutes</span>
        </div>

        <form class="mt-8 grid gap-6" name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>Do not fill this out if you are human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="grid gap-6 sm:grid-cols-2">
            <label>
              <span class="field-label">Your name <span class="text-accent">*</span></span>
              <input class="field-control" type="text" name="name" autocomplete="name" required placeholder="Your name" />
            </label>
            <label>
              <span class="field-label">Business name <span class="text-accent">*</span></span>
              <input class="field-control" type="text" name="business" autocomplete="organization" required placeholder="Business name" />
            </label>
          </div>

          <label>
            <span class="field-label">Type of business <span class="text-accent">*</span></span>
            <select class="field-control" name="business-type" required>
              <option value="" selected disabled>Select the closest fit</option>
              <option>Marine trade</option>
              <option>Pool service</option>
              <option>HVAC</option>
              <option>Landscaping</option>
              <option>Detailing</option>
              <option>Specialty contractor</option>
              <option>Inspector or surveyor</option>
              <option>Other service business</option>
            </select>
          </label>

          <div class="grid gap-6 sm:grid-cols-2">
            <label>
              <span class="field-label">Phone <span class="text-accent">*</span></span>
              <input class="field-control" type="tel" name="phone" autocomplete="tel" inputmode="tel" required placeholder="Your best number" />
            </label>
            <label>
              <span class="field-label">Email <span class="text-accent">*</span></span>
              <input class="field-control" type="email" name="email" autocomplete="email" required placeholder="you@business.com" />
            </label>
          </div>

          <label>
            <span class="field-label">What do you need? <span class="text-accent">*</span></span>
            <textarea class="field-control min-h-36 resize-y" name="what-they-need" required placeholder="No website, old website, Google listing problem, new service page—whatever is true."></textarea>
          </label>

          <div class="flex flex-col gap-4 border-t border-line pt-7 sm:flex-row sm:items-center sm:justify-between">
            <p class="max-w-xs text-xs leading-relaxed text-slate">Your details go only to Jack for this project conversation.</p>
            <button class="button button-accent sm:min-w-48" type="submit">Send to Jack <span aria-hidden="true">→</span></button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
