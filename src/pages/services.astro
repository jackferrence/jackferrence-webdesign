---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import PackageCard from "../components/PackageCard.astro";
import PageHero from "../components/PageHero.astro";
import { bundles, faqs, site } from "../data/site";

const services = [
  { name: "Google Business Profile setup", price: "$400", detail: "Claiming or clean setup, categories, services, description, photos, hours, and core profile fields." },
  { name: "Domain + business email setup", price: "$200", detail: "Domain connection, DNS, and a professional address using your own domain." },
  { name: "One-page website", price: "$900", detail: "Custom strategy, design, copy, mobile build, lead form, local SEO basics, and launch.", timing: "1 week" },
  { name: "Three-page website", price: "$1,600", detail: "Home plus two focused pages, with custom copy and a stronger local search footprint.", timing: "2 weeks" },
  { name: "Five-page website", price: "$2,400", detail: "A complete service site with deeper content for multiple high-value offerings.", timing: "3 weeks" },
  { name: "Extra service page", price: "$250", detail: "A targeted landing page for one additional service, built to match the main site." },
  { name: "On-site photo session", price: "$350", detail: "A practical local shoot for the owner, team, equipment, process, and finished work." },
  { name: "Review request system", price: "$200", detail: "A simple branded link and repeatable process that makes asking happy customers easier." },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${site.url}/services/#service`,
  name: "Web design and Google Business Profile setup",
  description: "Websites, local business listing setup, and ongoing web support for owner-operated service companies in Southern California.",
  provider: { "@id": `${site.url}/#business` },
  areaServed: site.serviceAreas.map((name) => ({ "@type": "Place", name })),
  serviceType: "Website design and local online presence setup",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website and local presence services",
    itemListElement: [
      { "@type": "Offer", price: "400", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "Google Business Profile setup" } },
      { "@type": "Offer", price: "900", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "One-page website" } },
      { "@type": "Offer", price: "1600", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "Three-page website" } },
      { "@type": "Offer", price: "2400", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "Five-page website" } },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout title="Service Business Website Packages" description="Compare website packages, Google Business Profile setup, review systems, photography, and domain email help for California service companies." structuredData={[serviceSchema, faqSchema]}>
  <PageHero eyebrow="Services & pricing" title="Buy the pieces you need—or bundle the whole local presence." intro="Start with a free personalized demo. These are the packages and prices if you decide to have Jack finish and launch the site.">
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a class="button button-accent" href="#bundles">Compare bundles <span aria-hidden="true">↓</span></a>
      <a class="button button-ghost-light" href="/contact/">Request My Free Demo</a>
    </div>
  </PageHero>

  <section class="section-pad bg-mist">
    <div class="container">
      <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
        <div>
          <p class="eyebrow">À la carte</p>
          <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Start with exactly what is missing.</h2>
          <p class="mt-6 text-base leading-relaxed text-slate">Useful when the site is fine but the Google listing is not—or when one strong service page will do more than a full rebuild.</p>
        </div>
        <div class="divide-y divide-line border-y border-line">
          {services.map((item) => (
            <article class="grid gap-3 py-6 sm:grid-cols-[1fr_auto] sm:gap-8">
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="text-lg font-extrabold tracking-[-0.025em] text-navy">{item.name}</h3>
                  {item.timing && <span class="rounded-full bg-sea/10 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[0.1em] text-sea">{item.timing}</span>}
                </div>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate">{item.detail}</p>
              </div>
              <p class="text-xl font-extrabold tracking-[-0.03em] text-accent">{item.price}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad border-y border-line bg-paper" id="bundles">
    <div class="container">
      <div class="max-w-3xl">
        <p class="eyebrow">Launch bundles</p>
        <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">The site and the local setup, handled together.</h2>
        <p class="mt-6 text-lg leading-relaxed text-slate">Bundles remove the coordination work and cost less than buying every included item separately.</p>
      </div>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {bundles.map((item) => <PackageCard {...item} />)}
      </div>
    </div>
  </section>

  <section class="section-pad bg-mist">
    <div class="container grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
      <div>
        <p class="eyebrow">Ongoing care</p>
        <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Support without the agency handoff.</h2>
        <p class="mt-6 text-base leading-relaxed text-slate">Monthly care is optional. The website remains yours whether you keep a plan or request help as needed.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <article class="rounded-2xl border border-line bg-white p-7 sm:p-8">
          <div class="flex items-end justify-between gap-5"><h3 class="text-2xl font-extrabold">Care</h3><p class="text-2xl font-extrabold text-accent">$100<span class="text-xs text-slate">/mo</span></p></div>
          <ul class="mt-7 grid gap-3 text-sm font-semibold text-navy">
            <li>✓ Core software and dependency updates</li><li>✓ Uptime and broken-link checks</li><li>✓ Up to 45 minutes of content edits</li><li>✓ Priority response from Jack</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-sea/40 bg-white p-7 sm:p-8">
          <div class="flex items-end justify-between gap-5"><h3 class="text-2xl font-extrabold">Care+</h3><p class="text-2xl font-extrabold text-sea">$175<span class="text-xs text-slate">/mo</span></p></div>
          <ul class="mt-7 grid gap-3 text-sm font-semibold text-navy">
            <li>✓ Everything in Care</li><li>✓ Up to 90 minutes of content edits</li><li>✓ Quarterly Google profile review</li><li>✓ Faster update turnaround</li>
          </ul>
        </article>
        <div class="sm:col-span-2 flex flex-col gap-3 rounded-xl bg-navy px-6 py-5 text-white sm:flex-row sm:items-center sm:justify-between">
          <p><strong>À la carte support</strong><span class="mt-1 block text-sm text-white/60">For updates without a monthly plan.</span></p>
          <p class="text-xl font-extrabold">$80/hour</p>
        </div>
        <p class="sm:col-span-2 text-sm text-slate">Already on a Care plan? Reach the support line directly at <a class="font-extrabold text-navy underline decoration-accent decoration-2 underline-offset-4" href={site.supportEmailHref}>{site.supportEmail}</a>.</p>
      </div>
    </div>
  </section>

  <section class="section-pad border-t border-line bg-paper" id="faq">
    <div class="container grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <div>
        <p class="eyebrow">Common questions</p>
        <h2 class="mt-6 text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Before we talk.</h2>
        <p class="mt-6 text-base leading-relaxed text-slate">If your question is more specific, call or send the form. Jack will tell you plainly whether he can help.</p>
      </div>
      <div class="divide-y divide-line border-y border-line">
        {faqs.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary><span>{item.question}</span><i aria-hidden="true">+</i></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Not sure which scope fits?" text="A 20-minute call is enough to sort out what is actually missing. Jack will recommend the smallest package that solves the problem." />
</BaseLayout>
