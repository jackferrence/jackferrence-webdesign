---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import PackageCard from "../components/PackageCard.astro";
import PageHero from "../components/PageHero.astro";
import { additionalServices, faqs, packages, site } from "../data/site";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${site.url}/services/#service`,
  name: "Web design, Google Business Profile, and Yelp setup",
  description: "Websites, Google Business Profile and Yelp listing setup, and ongoing web support for owner-operated service companies across California.",
  provider: { "@id": `${site.url}/#business` },
  areaServed: site.serviceAreas.map((name) => ({ "@type": "Place", name })),
  serviceType: "Website design and local online presence setup",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website and local presence services",
    itemListElement: [
      { "@type": "Offer", price: "1200", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "One-page website" } },
      { "@type": "Offer", price: "1900", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "Three-page website" } },
      { "@type": "Offer", price: "2500", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "Five-page website" } },
      { "@type": "Offer", price: "500", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "Google Business Profile setup" } },
      { "@type": "Offer", price: "500", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "Yelp profile setup" } },
      { "@type": "Offer", price: "750", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "Google + Yelp together" } },
      { "@type": "Offer", price: "300", priceCurrency: "USD", itemOffered: { "@type": "Service", name: "Yelp Request a Quote setup" } },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout title="Service Business Website Packages" description="Compare website packages, Google Business Profile and Yelp setup, review systems, photography, and domain email help for California service companies." structuredData={[serviceSchema, faqSchema]}>
  <PageHero eyebrow="Services & pricing" title="A clear price for the website. Add exactly what else you need." intro="Start with a free personalized demo. These are the packages and prices if you decide to have Jack finish and launch the site.">
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a class="button button-accent" href="#packages">Compare packages <span aria-hidden="true">↓</span></a>
      <a class="button button-ghost-light" href="/contact/">Book a Call</a>
    </div>
  </PageHero>

  <section class="section-pad bg-mist" id="packages">
    <div class="container">
      <div class="max-w-3xl">
        <p class="eyebrow">Website packages</p>
        <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Pick the size. Everything else is included.</h2>
        <p class="mt-6 text-lg leading-relaxed text-slate">Every package includes all copywriting, domain setup, business email setup, and two rounds of revisions. Delivered in about two weeks.</p>
      </div>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {packages.map((item) => <PackageCard {...item} />)}
      </div>
      <p class="mt-6 text-sm text-slate">Additional revisions beyond the two included are billed at $110/hour.</p>
      <p class="mt-3 text-sm text-slate">
        Not sure which one? Fill out{" "}
        <a class="font-extrabold text-navy underline decoration-accent decoration-2 underline-offset-4" href={site.googleFormUrl} target="_blank" rel="noopener noreferrer">
          the form <span aria-hidden="true">↗</span>
        </a>{" "}
        and I'll tell you which fits.
      </p>
    </div>
  </section>

  <section class="section-pad border-y border-line bg-paper">
    <div class="container">
      <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
        <div>
          <p class="eyebrow">Additional services</p>
          <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Add exactly what is missing.</h2>
          <p class="mt-6 text-base leading-relaxed text-slate">Useful when the site is fine but the Google or Yelp listing is not—or when one strong service page will do more than a full rebuild.</p>
        </div>
        <div class="divide-y divide-line border-y border-line">
          {additionalServices.map((item) => (
            <article class="grid gap-3 py-6 sm:grid-cols-[1fr_auto] sm:gap-8">
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="text-lg font-extrabold tracking-[-0.025em] text-navy">{item.name}</h3>
                  {item.timing && <span class="rounded-full bg-sea/10 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[0.1em] text-sea">{item.timing}</span>}
                </div>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate">{item.detail}</p>
              </div>
              <p class="text-xl font-extrabold tracking-[-0.03em] text-accent">{item.price}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-mist">
    <div class="container grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
      <div>
        <p class="eyebrow">Ongoing care</p>
        <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Support without the agency handoff.</h2>
        <p class="mt-6 text-base leading-relaxed text-slate">Monthly care is optional. The website remains yours whether you keep a plan or request help as needed. Care plans begin at launch.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <article class="rounded-2xl border border-line bg-white p-7 sm:p-8">
          <div class="flex items-end justify-between gap-5"><h3 class="text-2xl font-extrabold">Care</h3><p class="text-2xl font-extrabold text-accent">$100<span class="text-xs text-slate">/mo</span></p></div>
          <ul class="mt-7 grid gap-3 text-sm font-semibold text-navy">
            <li>✓ Hosting, security, and monitoring</li><li>✓ Priority response from Jack</li><li>✓ 1 hour of content updates</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-sea/40 bg-white p-7 sm:p-8">
          <div class="flex items-end justify-between gap-5"><h3 class="text-2xl font-extrabold">Care+</h3><p class="text-2xl font-extrabold text-sea">$225<span class="text-xs text-slate">/mo</span></p></div>
          <ul class="mt-7 grid gap-3 text-sm font-semibold text-navy">
            <li>✓ Everything in Care</li><li>✓ 3 hours of content updates</li><li>✓ Monthly Google profile posts</li>
          </ul>
        </article>
        <div class="sm:col-span-2 flex flex-col gap-3 rounded-xl bg-navy px-6 py-5 text-white sm:flex-row sm:items-center sm:justify-between">
          <p><strong>À la carte support</strong><span class="mt-1 block text-sm text-white/60">No plan. Changes as needed, 1-hour minimum.</span></p>
          <p class="text-xl font-extrabold">$110/hour</p>
        </div>
        <p class="sm:col-span-2 text-sm text-slate">Unused hours do not roll over. Already on a Care plan? Reach the support line directly at <a class="font-extrabold text-navy underline decoration-accent decoration-2 underline-offset-4" href={site.supportEmailHref}>{site.supportEmail}</a>.</p>
      </div>
    </div>
  </section>

  <section class="section-pad border-t border-line bg-paper" id="faq">
    <div class="container grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <div>
        <p class="eyebrow">Common questions</p>
        <h2 class="mt-6 text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Before we talk.</h2>
        <p class="mt-6 text-base leading-relaxed text-slate">If your question is more specific, call or send the form. Jack will tell you plainly whether he can help.</p>
      </div>
      <div class="divide-y divide-line border-y border-line">
        {faqs.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary><span>{item.question}</span><i aria-hidden="true">+</i></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Not sure which scope fits?" text="A 20-minute call is enough to sort out what is actually missing. Jack will recommend the smallest package that solves the problem." />
</BaseLayout>
