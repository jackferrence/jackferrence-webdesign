---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import DemoCard from "../components/DemoCard.astro";
import PageHero from "../components/PageHero.astro";
import { demos } from "../data/site";
---

<BaseLayout title="Service Business Website Demos" description="See website demos designed for marine, pool, HVAC, and other local service companies, with clear services, local proof, and strong calls to action.">
  <PageHero eyebrow="Example demos" title="The trade changes. The job stays the same: earn the call." intro="Every concept starts with the real buying decision—what the customer needs to understand, trust, and do next.">
    <div class="mt-9 inline-flex items-center gap-3 rounded-lg border border-white/15 bg-white/[0.06] px-4 py-3 text-sm font-bold text-white/72">
      <span class="h-2 w-2 shrink-0 rounded-full bg-accent"></span>
      These are demonstration builds, not presented as completed client projects.
    </div>
    <a class="button button-accent mt-6" href="/contact/">Request My Free Demo <span aria-hidden="true">→</span></a>
  </PageHero>

  <section class="section-pad bg-mist">
    <div class="container">
      <div class="grid gap-6 md:grid-cols-2">
        {demos.map((demo) => <DemoCard trade={demo.trade} packageName={demo.package} name={demo.name} kicker={demo.kicker} theme={demo.theme} url={demo.url} />)}
      </div>

      <div class="mt-6 grid min-h-72 place-items-center rounded-2xl border border-dashed border-slate/35 bg-paper p-8 text-center">
        <div>
          <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-accent/10 text-xl font-black text-accent" aria-hidden="true">+</span>
          <p class="mt-5 text-xs font-black uppercase tracking-[0.15em] text-sea">Open portfolio slot</p>
          <h2 class="mt-3 text-3xl font-black tracking-[-0.04em] text-navy">Your service business could be next.</h2>
          <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-slate">A real project replaces the demo label with your business, your work, and a site built around the calls you want.</p>
          <a class="button button-primary mt-7" href="/contact/">Request My Free Demo <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad border-y border-line bg-paper">
    <div class="container grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
      <div>
        <p class="eyebrow">What the demos prove</p>
        <h2 class="mt-6 text-balance text-4xl font-black tracking-[-0.05em] text-navy sm:text-5xl">Not one style pasted onto every trade.</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <article class="work-principle"><span>01</span><h3>Plain positioning</h3><p>The service and service area are obvious before the visitor scrolls.</p></article>
        <article class="work-principle"><span>02</span><h3>Trade-specific proof</h3><p>Credentials, turnaround, process, pricing, and risk are matched to the job.</p></article>
        <article class="work-principle"><span>03</span><h3>Calls over clutter</h3><p>No carousels, vague slogans, or effects that slow down the decision.</p></article>
        <article class="work-principle"><span>04</span><h3>Mobile by default</h3><p>The phone number and next step stay easy to reach from the dock or jobsite.</p></article>
      </div>
    </div>
  </section>

  <CTASection title="Give the next referral somewhere good to land." text="Tell Jack the trade, service area, and kind of work you want more of. He will turn that into a clear site plan." />
</BaseLayout>

<style>
  .work-principle { border-top: 2px solid var(--color-navy); padding-top: 1.1rem; }
  .work-principle span { color: var(--color-accent); font-size: 0.65rem; font-weight: 900; letter-spacing: 0.13em; }
  .work-principle h3 { margin-top: 0.85rem; color: var(--color-navy); font-size: 1.1rem; font-weight: 900; letter-spacing: -0.025em; }
  .work-principle p { margin-top: 0.6rem; color: var(--color-slate); font-size: 0.85rem; line-height: 1.7; }
</style>
