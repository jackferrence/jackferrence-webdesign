---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import DemoCard from "../components/DemoCard.astro";
import PageHero from "../components/PageHero.astro";
import { demos, site } from "../data/site";

const steps = [
  {
    number: "01",
    title: "You agree to a demo",
    text: "No cost. No card. No contract. You are agreeing to twenty minutes on the phone and a look at what I build. Nothing more than that.",
  },
  {
    number: "02",
    title: "You answer the questions",
    text: "One call, about twenty minutes. What you do, where you work, what you charge, what your license and insurance say, and which jobs you actually want more of. You do not write anything down. I do.",
  },
  {
    number: "03",
    title: "I build the site",
    text: "Seven days. Copy written, pages built, structure set up so people searching for your work can find it. Real content, not lorem ipsum with your logo dropped in.",
  },
  {
    number: "04",
    title: "We walk through it together",
    text: "Twenty minutes on Zoom. I show you the site, page by page, and explain why each part is there. You tell me what is wrong. Most of it will be right, because I asked the right questions in step two.",
  },
  {
    number: "05",
    title: "You choose what you want",
    text: "Now you know exactly what you are buying, because you are looking at it. Pick the package. Add the Google Business Profile setup or leave it. Nothing is bundled in that you did not ask for.",
  },
  {
    number: "06",
    title: "Half down, and the clock starts",
    text: "Fifty percent to begin. The two-week timeline starts when I have your answers and your photos, not the day you pay. Two rounds of revisions are included.",
  },
  {
    number: "07",
    title: "It goes live, then the balance",
    text: "You approve it, it launches, and the remaining fifty percent is due. The site is yours. The domain is in your name. If you take the care plan, you have somebody to call. If you do not, you still own everything.",
  },
];
---

<BaseLayout title="How It Works" description="A demo-first website process: agree to a free demo, answer a few questions, and see a real site within seven days before you decide whether to pay for anything.">
  <PageHero eyebrow="How it works" title="You will see your website before you pay for it." intro="Most people who call me have already been burned once. Money up front, six months of silence, a half-finished site nobody ever launched. So I built the process backwards. You get a real site first. You decide after.">
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a class="button button-accent" href="/services/">See the packages</a>
      <a class="button button-ghost-light" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
  </PageHero>

  <section class="section-pad bg-mist">
    <div class="container grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
      <div>
        <p class="eyebrow">The reason</p>
        <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Nothing gets built while you wait on yourself.</h2>
      </div>
      <div class="max-w-2xl">
        <p class="text-lg leading-relaxed text-slate">Website projects do not stall because the work is hard. They stall because the web guy asked you for content and you have a business to run.</p>
        <p class="mt-5 text-base leading-relaxed text-slate">So I do not ask you for content. I ask you questions, once, and I write everything from your answers. Photos, copy, service pages, the Google listing. You approve it. You do not produce it.</p>
        <p class="mt-5 text-base font-bold leading-relaxed text-navy">That is why two weeks is a real number and not a hope.</p>
      </div>
    </div>
  </section>

  <section class="section-pad border-y border-line bg-paper">
    <div class="container">
      <p class="eyebrow">Start to finish</p>
      <h2 class="mt-6 max-w-2xl text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Seven steps. No mystery in any of them.</h2>
      <ol class="mt-12 grid divide-y divide-line border-y border-line">
        {steps.map((step) => (
          <li class="process-step">
            <span>{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-pad bg-mist">
    <div class="container">
      <p class="eyebrow">See it before you decide</p>
      <h2 class="mt-6 max-w-2xl text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">These went through this exact process.</h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate">Every demo below started as a twenty-minute call, not a blank page.</p>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {demos.map((demo) => <DemoCard trade={demo.trade} packageName={demo.package} name={demo.name} kicker={demo.kicker} theme={demo.theme} url={demo.url} compact />)}
      </div>
    </div>
  </section>

  <section class="section-pad border-y border-line bg-paper">
    <div class="container grid gap-12 lg:grid-cols-2 lg:gap-24">
      <div>
        <p class="eyebrow">Just so it is said</p>
        <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">No retainer to find out.</h2>
      </div>
      <div class="max-w-2xl">
        <p class="text-lg leading-relaxed text-slate">You are not paying a discovery fee. You are not signing a twelve-month contract to get a quote. You are not going to get a forty-page proposal with a number buried on page thirty-one.</p>
        <p class="mt-5 text-base leading-relaxed text-slate">You get a real website in seven days, a straight conversation about it, and a price you already saw on the pricing page.</p>
        <p class="mt-5 text-base font-bold leading-relaxed text-navy">If you look at it and decide no, that is a fine outcome. You keep the demo link. I keep the practice.</p>
      </div>
    </div>
  </section>

  <CTASection title="Start with the demo." text="Tell me what you do and where you work. Seven days later you will be looking at your own website, and you will not have spent anything." />
</BaseLayout>

<style>
  .process-step { display: grid; grid-template-columns: 3rem 1fr; gap: 1.5rem; padding-block: 1.8rem; }
  .process-step span { display: inline-grid; height: 2.5rem; width: 2.5rem; place-items: center; border-radius: 999px; background: var(--color-accent); color: white; font-size: 0.72rem; font-weight: 700; }
  .process-step h3 { color: var(--color-navy); font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; }
  .process-step p { margin-top: 0.5rem; max-width: 40rem; color: var(--color-slate); font-size: 0.92rem; line-height: 1.7; }
</style>
