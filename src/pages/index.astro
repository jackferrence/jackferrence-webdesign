---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import DemoCard from "../components/DemoCard.astro";
import { demoFaqs, demos, site } from "../data/site";

const description = "Get a personalized website demo for your California service business in under seven days. No cost or commitment. Built directly by Jack Ferrence.";

const referralQuestions = ["What do you do?", "Where do you work?", "Why should someone trust you?", "What should they do next?"];
---

<BaseLayout title="Websites for California Service Companies" description={description}>
  <section class="hero relative overflow-hidden bg-mist py-16 sm:py-24 lg:py-30">
    <div class="container grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div class="hero-in" style="--d: 0ms">
        <p class="eyebrow">Websites for service companies in California</p>
        <h1 class="mt-7 max-w-3xl text-balance text-[clamp(2.5rem,5.5vw,4.6rem)] font-extrabold leading-[1.05] tracking-[-0.03em] text-navy">
          See your new website <span class="text-accent">before you pay for it.</span>
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-slate sm:text-xl">
          Jack creates a personalized website demo for your service business in under seven days. No cost. No commitment. If you like the direction, he can finish and launch the site.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="button button-accent" href={site.phoneHref}>Call Now <span aria-hidden="true">→</span></a>
          <a class="button button-primary" href="/contact/">Book a Call</a>
          <a class="button button-outline" href={site.googleFormUrl} target="_blank" rel="noopener noreferrer">Request a Demo <span aria-hidden="true">↗</span></a>
        </div>
        <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 border-t border-line pt-6 text-xs font-extrabold uppercase tracking-[0.1em] text-slate">
          <span>Personalized to your business</span><span>Delivered in under 7 days</span><span>Built by Jack</span>
        </div>
      </div>

      <div class="relative">
        <div class="hero-ring absolute -left-8 -top-8 h-24 w-24 rounded-full border-2 border-sea/40"></div>
        <div class="hero-in hero-card relative rounded-2xl border border-line bg-white p-6 shadow-[0_30px_80px_rgba(11,29,42,0.14)] sm:p-10" style="--d: 160ms">
          <div class="flex items-center justify-between border-b border-line pb-6">
            <div>
              <p class="text-sm font-extrabold uppercase tracking-[0.15em] text-sea">A real referral</p>
              <p class="mt-2 text-lg font-bold text-navy">What happens after someone says your name?</p>
            </div>
            <span class="h-3 w-3 shrink-0 rounded-full bg-accent shadow-[0_0_0_7px_rgba(201,43,14,0.1)]"></span>
          </div>
          <ol class="mt-5 grid">
            <li class="referral-step hero-in" style="--d: 460ms">
              <span>01</span><div><b>They hear your name</b><p>A neighbor, property owner, or past customer recommends you.</p></div><i class="bg-sea"></i>
            </li>
            <li class="referral-step hero-in" style="--d: 610ms">
              <span>02</span><div><b>They search for you</b><p>Your online presence has a few seconds to confirm the referral.</p></div><i class="bg-accent"></i>
            </li>
            <li class="referral-step hero-in" style="--d: 760ms">
              <span>03</span><div><b>They decide who looks real</b><p>Clear services, real proof, and an easy next step win the call.</p></div><i class="bg-sea"></i>
            </li>
            <li class="referral-step hero-in border-b-0" style="--d: 910ms">
              <span>04</span><div><b>Your customer calls</b><p>The site did its job. You take it from there.</p></div><i class="bg-navy"></i>
            </li>
          </ol>
          <a class="hero-in hero-cta mt-4 flex items-center justify-between rounded-xl bg-navy p-6 text-white" style="--d: 1080ms" href={site.phoneHref}>
            <span><small class="block text-xs font-extrabold uppercase tracking-[0.15em] text-white/55">Ready to call</small><b class="mt-1 block text-xl">{site.phoneDisplay}</b></span>
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-accent text-xl" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-mist" id="demos">
    <div class="container">
      <div class="flex items-end justify-between gap-8">
        <div>
          <p class="eyebrow">Example demos</p>
          <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Built around the way each service is actually sold.</h2>
        </div>
      </div>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate">A marine surveyor, hull service, and HVAC contractor should not sound or look identical. These are demonstration builds, not presented as completed client projects.</p>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {demos.map((demo) => <DemoCard trade={demo.trade} packageName={demo.package} name={demo.name} kicker={demo.kicker} theme={demo.theme} url={demo.url} compact />)}
      </div>
    </div>
  </section>

  <section class="section-pad bg-navy text-white">
    <div class="container grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-24">
      <div>
        <p class="eyebrow">The referral leak</p>
        <h2 class="mt-6 text-balance text-4xl font-extrabold leading-[1] tracking-[-0.05em] sm:text-5xl">Good work can still lose the call online.</h2>
      </div>
      <div class="max-w-2xl">
        <p class="text-xl leading-relaxed text-white/78 sm:text-2xl">A customer hears your name from a neighbor, property owner, or past client. Then they search for you.</p>
        <p class="mt-6 text-base leading-relaxed text-white/58">If they find no website, an outdated page, or no clear way to request service, the referral does not disappear—it often goes to the next company that looks easier to trust. 39% of consumers have decided not to use a business specifically because it had no website, rising to 45% among ages 18–44 (DreamHost Local Business Trust Index, 2026). Your website does not need to be complicated. It needs to quickly answer four questions:</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {referralQuestions.map((question) => (
            <li class="flex items-start gap-3 text-sm font-bold text-white/90">
              <span class="mt-0.5 text-accent-bright" aria-hidden="true">→</span>{question}
            </li>
          ))}
        </ul>
        <p class="mt-8 text-base font-bold leading-relaxed text-white">Your reputation already did the hard part. Your website should help it finish the job.</p>
      </div>
    </div>
  </section>

  <section class="section-pad bg-paper">
    <div class="container">
      <p class="eyebrow">See the direction first</p>
      <h2 class="mt-6 max-w-3xl text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">A website concept made for your business—not a generic sales pitch.</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate">Tell Jack about your services, customers, and location. He will create a personalized website demo that shows how your business could be presented online. You see the messaging, page direction, and customer path before deciding whether to spend anything.</p>
      <div class="mt-10 flex flex-col divide-y divide-line rounded-2xl border border-line bg-white sm:flex-row sm:divide-x sm:divide-y-0">
        <div class="flex-1 p-6">
          <h3 class="text-xs font-extrabold uppercase tracking-[0.12em] text-sea">Personalized</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">Built around your actual services, service area, and business identity.</p>
        </div>
        <div class="flex-1 p-6">
          <h3 class="text-xs font-extrabold uppercase tracking-[0.12em] text-sea">Fast</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">Delivered in under seven days after Jack receives the information he needs.</p>
        </div>
        <div class="flex-1 p-6">
          <h3 class="text-xs font-extrabold uppercase tracking-[0.12em] text-sea">No pressure</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">Review the demo first. Decide afterward whether a paid build makes sense.</p>
        </div>
      </div>
      <a class="button button-accent mt-9" href="/contact/">Book a Call <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section-pad bg-paper">
    <div class="container grid gap-14 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24">
      <div>
        <p class="eyebrow">Built by someone who gets both sides</p>
        <h2 class="mt-6 text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Technical enough to build it right. Practical enough to keep it useful.</h2>
      </div>
      <div class="max-w-2xl">
        <p class="text-lg leading-relaxed text-slate">Jack Ferrence has a B.S. in Computer Science from Biola University and firsthand experience running a pressure-washing service business. He understands that a service website is not an art project—it is a tool that should make the business look credible and help the right customer take action.</p>
        <p class="mt-5 text-base leading-relaxed text-slate">You work directly with Jack from the first conversation through launch. He writes the site, builds it, and stays reachable when something needs attention.</p>
        <ul class="mt-7 grid gap-3 sm:grid-cols-2">
          <li class="flex items-start gap-3 text-sm font-bold text-navy"><span class="mt-0.5 text-sea" aria-hidden="true">✓</span>B.S. in Computer Science, Biola University</li>
          <li class="flex items-start gap-3 text-sm font-bold text-navy"><span class="mt-0.5 text-sea" aria-hidden="true">✓</span>Firsthand service-business experience</li>
          <li class="flex items-start gap-3 text-sm font-bold text-navy"><span class="mt-0.5 text-sea" aria-hidden="true">✓</span>Based in Newport Beach, serving California</li>
          <li class="flex items-start gap-3 text-sm font-bold text-navy"><span class="mt-0.5 text-sea" aria-hidden="true">✓</span>Direct access to the person doing the work</li>
        </ul>
        <a class="mt-8 inline-flex items-center gap-2 text-sm font-extrabold text-navy underline decoration-accent decoration-2 underline-offset-6" href="/about/">About Jack <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section-pad bg-mist">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-6 max-w-2xl text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">See the work before you make the decision.</h2>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        <article class="plan-step">
          <span>01</span>
          <h3>Tell Jack about the business</h3>
          <p>Share your services, location, current website if you have one, and what you want customers to do.</p>
        </article>
        <article class="plan-step">
          <span>02</span>
          <h3>Review your free demo</h3>
          <p>Within seven days, Jack sends a personalized website direction built around your business.</p>
        </article>
        <article class="plan-step">
          <span>03</span>
          <h3>Choose what happens next</h3>
          <p>If the direction fits, choose a website package and Jack finishes the build. If not, you are not committed.</p>
        </article>
      </div>
      <a class="button button-primary mt-9" href="/contact/">Book a Call <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section-pad bg-paper">
    <div class="container">
      <p class="eyebrow">More than a good-looking page</p>
      <h2 class="mt-6 max-w-2xl text-balance text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">The pieces customers need to find you, trust you, and contact you.</h2>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate">The website is the core offer. When needed, Jack can also help put the supporting basics in place so the site works as part of one clear customer path.</p>
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <article class="rounded-2xl border border-navy/15 bg-navy p-7 text-white lg:row-span-4 lg:flex lg:flex-col lg:justify-center">
          <p class="text-xs font-extrabold uppercase tracking-[0.12em] text-accent-bright">The core offer</p>
          <h3 class="mt-3 text-xl font-extrabold tracking-[-0.02em]">Sales website</h3>
          <ul class="mt-5 grid gap-3 text-sm font-semibold text-white/85">
            <li>✓ Clear service and location messaging</li><li>✓ Mobile-first pages</li><li>✓ Calls and quote-request paths</li><li>✓ Copywriting included</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-line bg-white p-6">
          <h3 class="text-base font-extrabold tracking-[-0.02em] text-navy">Google Business Profile setup</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">Set up or organize the profile customers use to find and verify your business on Google.</p>
        </article>
        <article class="rounded-2xl border border-line bg-white p-6">
          <h3 class="text-base font-extrabold tracking-[-0.02em] text-navy">Yelp profile setup</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">Set up or organize your Yelp business page, or bundle it with the Google profile.</p>
        </article>
        <article class="rounded-2xl border border-line bg-white p-6">
          <h3 class="text-base font-extrabold tracking-[-0.02em] text-navy">Review request system</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">Give satisfied customers a clear, repeatable way to leave a Google review. This is Google only—Yelp prohibits soliciting reviews and filters out ones it flags as solicited.</p>
        </article>
        <article class="rounded-2xl border border-line bg-white p-6">
          <h3 class="text-base font-extrabold tracking-[-0.02em] text-navy">On-site photo session</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">Capture real work, equipment, and locations so the site looks like your business.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-pad-tight bg-navy text-white">
    <div class="container grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow">If you decide to build</p>
        <h2 class="mt-4 text-balance text-3xl font-extrabold tracking-[-0.04em] sm:text-4xl">Clear packages after you have seen the direction.</h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-white/70">The personalized demo is free. If you want Jack to complete and launch the site, current website packages range from <strong class="text-white">$1,200 to $2,500</strong>.</p>
        <a class="button button-accent mt-6" href="/services/">See Packages and Prices <span aria-hidden="true">→</span></a>
      </div>
      <div class="border-t border-white/15 pt-8 lg:border-l lg:border-t-0 lg:pl-16 lg:pt-0">
        <p class="eyebrow">Proof that earns its place</p>
        <h2 class="mt-4 text-balance text-3xl font-extrabold tracking-[-0.04em] sm:text-4xl">See the thinking. Then judge the work.</h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-white/70">Verified client results will appear here as they become available. Until then, the example demos above show the design decisions behind each build.</p>
      </div>
    </div>
  </section>

  <section class="section-pad bg-mist" id="faq">
    <div class="container grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <div>
        <p class="eyebrow">Before you request a demo</p>
        <h2 class="mt-6 text-4xl font-extrabold tracking-[-0.05em] text-navy sm:text-5xl">Straight answers before you share your information.</h2>
      </div>
      <div class="divide-y divide-line border-y border-line">
        {demoFaqs.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary><span>{item.question}</span><i aria-hidden="true">+</i></summary>
            <p>
              {item.answer}{" "}
              {item.linkHref && (
                <a class="font-extrabold text-navy underline decoration-accent decoration-2 underline-offset-4" href={item.linkHref} target="_blank" rel="noopener noreferrer">
                  {item.linkText} <span aria-hidden="true">↗</span>
                </a>
              )}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="See what your business could look like online."
    text="Tell Jack what you do, where you work, and what is not working today. He will review the fit and create a personalized website demo in under seven days."
  />
</BaseLayout>

<style>
  .referral-step { position: relative; display: grid; grid-template-columns: 2.3rem 1fr 0.7rem; gap: 1rem; align-items: center; border-bottom: 1px solid var(--color-line); padding-block: 1.15rem; }
  .referral-step > span { font-size: 0.72rem; font-weight: 700; color: var(--color-slate); }
  .referral-step b { display: block; font-size: 1.02rem; color: var(--color-navy); }
  .referral-step p { margin-top: 0.3rem; max-width: 24rem; font-size: 0.84rem; line-height: 1.55; color: var(--color-slate); }
  .referral-step i { width: 0.6rem; height: 0.6rem; border-radius: 999px; }
  .plan-step { border-top: 2px solid var(--color-navy); padding-top: 1.1rem; }
  .plan-step span { display: inline-grid; height: 2.25rem; width: 2.25rem; place-items: center; border-radius: 999px; background: var(--color-accent); color: white; font-size: 0.7rem; font-weight: 700; }
  .plan-step h3 { margin-top: 1rem; color: var(--color-navy); font-size: 1.15rem; font-weight: 700; letter-spacing: -0.025em; }
  .plan-step p { margin-top: 0.6rem; color: var(--color-slate); font-size: 0.87rem; line-height: 1.7; }

  /* --- Hero: staggered entrance + scroll-linked trace --- */
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes step-trace {
    0% { border-left-color: transparent; background: transparent; }
    35% { border-left-color: var(--color-sea); background: rgb(23 127 131 / 5%); }
    100% { border-left-color: transparent; background: transparent; }
  }

  @keyframes cta-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgb(201 43 14 / 0%); }
    50% { box-shadow: 0 0 0 8px rgb(201 43 14 / 16%); }
  }

  @keyframes ring-drift {
    from { transform: translateY(0) rotate(0deg); }
    to { transform: translateY(46px) rotate(24deg); }
  }

  .hero-in {
    animation: hero-rise 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--d, 0ms);
  }

  .referral-step.hero-in {
    border-left: 2px solid transparent;
    margin-left: -1px;
    padding-left: calc(1px);
    animation:
      hero-rise 700ms cubic-bezier(0.16, 1, 0.3, 1) both,
      step-trace 900ms ease-out both;
    animation-delay: var(--d, 0ms), var(--d, 0ms);
  }

  .hero-cta.hero-in {
    animation:
      hero-rise 700ms cubic-bezier(0.16, 1, 0.3, 1) both,
      cta-pulse 1400ms ease-out 1;
    animation-delay: var(--d, 0ms), calc(var(--d, 0ms) + 500ms);
  }

  .hero-ring {
    will-change: transform;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-ring {
        animation: ring-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0px 900px;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .referral-step.hero-in,
    .hero-cta.hero-in,
    .hero-ring {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
