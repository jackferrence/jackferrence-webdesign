---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Message received" description="Thanks for contacting Jack Ferrence." noindex>
  <section class="grid min-h-[68vh] place-items-center bg-paper py-20">
    <div class="container text-center">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-sea text-2xl font-extrabold text-white" aria-hidden="true">✓</span>
      <p class="eyebrow mt-8 justify-center">Message received</p>
      <h1 class="mx-auto mt-6 max-w-3xl text-balance text-5xl font-extrabold tracking-[-0.055em] text-navy sm:text-6xl">Thanks. Jack has the details.</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate">He will review the note and follow up directly. If the project is time-sensitive, calling is always okay.</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a class="button button-primary" href={site.phoneHref}>Call {site.phoneDisplay}</a>
        <a class="button button-outline" href="/">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
