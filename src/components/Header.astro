---
import { navigation, site } from "../data/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header class="site-header">
  <div class="container flex h-[72px] items-center justify-between gap-6">
    <a href="/" class="brand-mark" aria-label={`${site.name} home`}>
      <img src="/logo-mark.png" alt="" width="28" height="28" class="rounded-full" />
      <span>{site.name}</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a class:list={["nav-link", { "nav-link-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a class="text-sm font-bold text-navy transition-colors hover:text-accent" href={site.phoneHref}>Call {site.phoneDisplay}</a>
      <a class="button button-small button-primary" href="/contact/">Request Free Demo</a>
    </div>

    <details class="mobile-menu lg:hidden">
      <summary aria-label="Open navigation">
        <span></span><span></span><span></span>
      </summary>
      <div class="mobile-menu-panel">
        <nav aria-label="Mobile navigation">
          {navigation.map((item) => (
            <a class:list={["mobile-nav-link", { "mobile-nav-link-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="mt-5 flex flex-col gap-3">
          <a class="button button-primary" href="/contact/">Request Free Demo</a>
          <a class="button button-outline" href={site.phoneHref}>Call {site.phoneDisplay}</a>
        </div>
      </div>
    </details>
  </div>
</header>
