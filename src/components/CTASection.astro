---
import { site } from "../data/site";
interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Keep the next referral from leaking.",
  text = "Tell Jack what you do and what is not working. You will get a clear recommendation—not a pitch deck.",
} = Astro.props;
---

<section class="section-pad bg-paper">
  <div class="container">
    <div class="cta-panel">
      <div>
        <p class="eyebrow">Ready when you are</p>
        <h2 class="mt-5 max-w-3xl text-balance text-4xl font-extrabold tracking-[-0.045em] text-white sm:text-5xl">{title}</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/68">{text}</p>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a class="button button-accent" href={site.googleFormUrl} target="_blank" rel="noopener noreferrer">Get My Free Demo — 10 min <span aria-hidden="true">↗</span></a>
        <a class="button button-ghost-light" href="/contact/">Book a Call</a>
        <a class="text-sm font-bold text-white/70 underline decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-white" href={site.phoneHref}>
          Call Now
        </a>
      </div>
    </div>
  </div>
</section>
