---
import { site } from "../data/site";
interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Keep the next referral from leaking.",
  text = "Tell Jack what you do and what is not working. You will get a clear recommendation—not a pitch deck.",
} = Astro.props;
---

<section class="section-pad bg-paper">
  <div class="container">
    <div class="cta-panel">
      <div>
        <p class="eyebrow text-accent">Ready when you are</p>
        <h2 class="mt-5 max-w-3xl text-balance text-4xl font-black tracking-[-0.045em] text-white sm:text-5xl">{title}</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/68">{text}</p>
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="button button-accent" href="/contact/">Start a project <span aria-hidden="true">→</span></a>
        <a class="button button-ghost-light" href={site.phoneHref}>Call {site.phoneDisplay}</a>
      </div>
    </div>
  </div>
</section>
